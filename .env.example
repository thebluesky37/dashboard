# Copy this file to .env and adjust values as needed.

# Primary Postgres settings
DB_NAME=rl_stg
DB_USER=rl_stg_admin
DB_PASS=rl_stg_admin
DB_URL=postgres
DB_PORT=5432
DB_SCHEMA=aidash

# Backend DSN (required by compose)
DATABASE_URL=postgresql+asyncpg://rl_stg_admin:rl_stg_admin@postgres:5432/rl_stg

# Backend app settings
ALLOWED_ORIGINS=http://localhost:7377,http://0.0.0.0:7377,http://localhost:5173,http://127.0.0.1:5173,http://localhost:9000
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
ALLOWED_FRAME_ANCESTORS=*
EMBED_SECRET=replace_with_long_random_secret
EMBED_API_KEY=replace_with_pre_shared_api_key

# MySQL sample service settings
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=rldashboard
MYSQL_USER=rldashboard
MYSQL_PASSWORD=rldashboard
